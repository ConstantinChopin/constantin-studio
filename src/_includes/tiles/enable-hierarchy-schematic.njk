<svg viewBox="0 0 1280 480" role="img" aria-label="Schematic: one field owned at three layers — canonical, organisation and personal — where vertical position encodes which layer owns a value. A higher layer overwriting a lower one is drawn as declined. On the right, the effective view names the owning layer on every row." style="position:absolute; inset:0; width:100%; height:100%">
  <!-- drawn for the case study in the site's own hand: paper, hairlines, mono
       notation. a diagram about the work — deliberately not fake UI.
       layer is encoded as y-position, because opacity is already the
       emphasis axis and cannot carry a second meaning. -->
  <g fill="none" stroke="#110f0f" stroke-width="1">

    <!-- the three bands -->
    <g stroke-opacity="0.2">
      <path d="M260 160 H720"/>
      <path d="M260 260 H720"/>
      <path d="M260 360 H720"/>
    </g>

    <!-- one value per layer -->
    <g stroke-opacity="0.5">
      <rect x="300" y="128" width="140" height="26" rx="4" fill="#fefaf8"/>
      <rect x="360" y="228" width="140" height="26" rx="4" fill="#fefaf8"/>
      <rect x="420" y="328" width="140" height="26" rx="4" fill="#fefaf8" stroke-dasharray="3 3"/>
    </g>

    <!-- the same field, tied across layers -->
    <g stroke-opacity="0.2">
      <path d="M440 141 H660"/>
      <path d="M500 241 H660"/>
      <path d="M560 341 H660"/>
      <path d="M660 128 V354" stroke-dasharray="2 6"/>
    </g>

    <!-- no silent overwrite -->
    <path d="M300 224 V184" stroke-opacity="0.28" stroke-dasharray="4 5"/>
    <circle cx="300" cy="172" r="6.5" fill="#fefaf8" stroke="#110f0f" stroke-opacity="0.4"/>
    <path d="M292 200 H244" stroke-opacity="0.25"/>

    <!-- the effective view -->
    <g stroke-opacity="0.55">
      <rect x="820" y="118" width="380" height="244" rx="10" fill="#fefaf8"/>
    </g>
    <g stroke-opacity="0.35">
      <rect x="842" y="166" width="220" height="28" rx="4"/>
      <rect x="842" y="206" width="220" height="28" rx="4"/>
      <rect x="842" y="246" width="220" height="28" rx="4" stroke-dasharray="3 3"/>
    </g>
  </g>

  <g font-family="'IBM Plex Mono', ui-monospace, monospace" fill="#110f0f">
    <g font-size="13" fill-opacity="0.4">
      <text x="80" y="152">canonical</text>
      <text x="80" y="252">organisation</text>
      <text x="80" y="352">personal</text>
    </g>

    <text x="672" y="246" font-size="12" fill-opacity="0.35">one field</text>
    <text x="238" y="204" font-size="12" fill-opacity="0.4" text-anchor="end">overwrite · declined</text>

    <text x="842" y="146" font-size="12" fill-opacity="0.35">effective view</text>
    <g font-size="11" fill-opacity="0.4">
      <text x="1076" y="184">canonical</text>
      <text x="1076" y="224">organisation</text>
      <text x="1076" y="264">personal</text>
    </g>
    <text x="842" y="318" font-size="11" fill-opacity="0.3">every row names its layer</text>

    <g font-size="14" fill-opacity="0.45">
      <text x="400" y="442" text-anchor="middle">one field · three owners</text>
      <text x="1010" y="442" text-anchor="middle">effective view · each row attributed</text>
    </g>
    <text x="1200" y="470" font-size="10" fill-opacity="0.28" text-anchor="end">data model · not implemented in the shipped prototype</text>
  </g>
</svg>
