<svg viewBox="0 0 1280 480" role="img" aria-label="Schematic: three sources disagree on one field, each carrying provenance and a confidence score. Auto-resolution is declined. A person decides, and the decision is stored at the organisation layer." style="position:absolute; inset:0; width:100%; height:100%">
  <!-- drawn for the case study in the site's own hand: paper, hairlines, mono
       notation. a diagram about the work — deliberately not fake UI.
       one accent (#C9A96E) reserved for the human decision, matching the
       product's own convention for a resolved value. -->
  <g fill="none" stroke="#110f0f" stroke-width="1">

    <!-- three sources, one field, three values -->
    <g stroke-opacity="0.5">
      <rect x="80" y="96" width="190" height="68" rx="8" fill="#fefaf8"/>
      <rect x="112" y="186" width="190" height="68" rx="8" fill="#fefaf8"/>
      <rect x="144" y="276" width="190" height="68" rx="8" fill="#fefaf8"/>
    </g>
    <g stroke-opacity="0.35">
      <rect x="96" y="132" width="118" height="10" rx="5"/>
      <rect x="128" y="222" width="96" height="10" rx="5"/>
      <rect x="160" y="312" width="126" height="10" rx="5"/>
    </g>

    <!-- convergence -->
    <g stroke-opacity="0.5">
      <path d="M270 130 C 400 130, 440 220, 516 220"/>
      <path d="M302 220 C 400 220, 440 220, 516 220"/>
      <path d="M334 310 C 420 310, 450 220, 516 220"/>
      <circle cx="270" cy="130" r="4" fill="#110f0f" fill-opacity="0.5" stroke="none"/>
      <circle cx="302" cy="220" r="4" fill="#110f0f" fill-opacity="0.5" stroke="none"/>
      <circle cx="334" cy="310" r="4" fill="#110f0f" fill-opacity="0.5" stroke="none"/>
      <circle cx="522" cy="220" r="5" fill="#110f0f" fill-opacity="0.5" stroke="none"/>
    </g>

    <!-- the road not taken -->
    <path d="M530 212 C 596 190, 616 158, 672 150" stroke-opacity="0.28" stroke-dasharray="4 5"/>
    <circle cx="688" cy="148" r="6.5" fill="#fefaf8" stroke="#110f0f" stroke-opacity="0.4"/>

    <!-- the road taken -->
    <g stroke-opacity="0.5">
      <path d="M530 230 C 598 258, 640 292, 698 298"/>
    </g>

    <!-- the human decision -->
    <circle cx="722" cy="300" r="11" fill="#fefaf8" stroke="#C9A96E" stroke-opacity="0.9"/>
    <circle cx="722" cy="300" r="3.5" fill="#C9A96E" stroke="none"/>

    <g stroke-opacity="0.5">
      <path d="M740 294 C 792 286, 806 240, 856 232"/>
      <circle cx="856" cy="232" r="4" fill="#110f0f" fill-opacity="0.5" stroke="none"/>
    </g>

    <!-- the resolved field -->
    <g stroke-opacity="0.6">
      <rect x="866" y="196" width="294" height="72" rx="10" fill="#fefaf8"/>
    </g>
    <path d="M884 214 V250" stroke="#C9A96E" stroke-width="2" stroke-opacity="0.9"/>
    <g stroke-opacity="0.5">
      <rect x="902" y="222" width="140" height="10" rx="5"/>
    </g>
    <path d="M1042 227 H1070" stroke-opacity="0.28"/>

    <!-- stored at the layer -->
    <path d="M1010 268 V318" stroke-opacity="0.22" stroke-dasharray="2 6"/>
    <path d="M880 318 H1160" stroke-opacity="0.2"/>
  </g>

  <g font-family="'IBM Plex Mono', ui-monospace, monospace" fill="#110f0f">
    <g font-size="11" fill-opacity="0.42">
      <text x="96" y="120">portal</text>
      <text x="128" y="210">booking platform</text>
      <text x="160" y="300">manual entry</text>
    </g>
    <g font-size="10" fill-opacity="0.38">
      <text x="222" y="141">92%</text>
      <text x="254" y="231">61%</text>
      <text x="286" y="321">—</text>
    </g>

    <text x="712" y="144" font-size="13" fill-opacity="0.45">auto-resolve</text>
    <text x="712" y="164" font-size="11" fill-opacity="0.3">declined</text>

    <text x="722" y="340" font-size="13" fill-opacity="0.55" text-anchor="middle">a person decides</text>

    <text x="902" y="250" font-size="11" fill-opacity="0.4">kept</text>
    <text x="1078" y="232" font-size="12" fill-opacity="0.45">src · 04·12</text>
    <text x="880" y="340" font-size="12" fill-opacity="0.4">stored · organisation layer</text>

    <g font-size="14" fill-opacity="0.45">
      <text x="207" y="440" text-anchor="middle">three sources · one field</text>
      <text x="1010" y="440" text-anchor="middle">a person decides · stored at the layer</text>
    </g>
  </g>
</svg>
